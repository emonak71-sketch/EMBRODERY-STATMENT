{
  "name": "embrodery-statement",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "version:bump": "node scripts/bump-version.mjs",
    "preview": "vite preview",
    "test:attendance": "node desktop/attendanceCore.test.mjs",
    "desktop:icons": "npx --yes @tauri-apps/cli@2 icon public/embroidery-statement-logo.svg --output src-tauri/icons",
    "desktop:dev": "npm run desktop:icons && npx --yes @tauri-apps/cli@2 dev",
    "desktop:build": "npm run desktop:icons && npx --yes @tauri-apps/cli@2 build",
    "desktop:check": "npm run desktop:icons && npx --yes @tauri-apps/cli@2 build --no-bundle"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.563.0",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2"
  }
}
